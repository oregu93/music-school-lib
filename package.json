{
  "name": "music-school-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mlc-staging",
    "build": "vite build --mode mlc-staging",
    "preview": "vite preview",
    "test:launch": "bash scripts/test-database.sh && node scripts/test-launch.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.launch.json",
    "launch:check": "pnpm test:launch && pnpm typecheck && pnpm build",
    "cf-typegen": "wrangler types --config wrangler.staging.jsonc",
    "build:staging": "vite build --mode mlc-staging",
    "build:production": "vite build --mode mlc-production",
    "deploy:staging": "node scripts/deploy-env.mjs staging",
    "deploy:production": "node scripts/deploy-env.mjs production",
    "db:migrate:staging": "wrangler d1 migrations apply music-school-library-staging --remote --config wrangler.staging.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply music-school-library --remote --config wrangler.production.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "license": "AGPL-3.0-or-later"
}
